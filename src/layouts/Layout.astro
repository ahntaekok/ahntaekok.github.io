---
import '@/styles/global.css';
import profile from '@/data/profile.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} (${profile.nameEn}) — ${profile.role}`,
  description = profile.headline,
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0e1a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/variable/pretendardvariable.min.css"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <title>{title}</title>

    <script is:inline>
      // 깜빡임(FOUC) 방지 — 페인트 전에 테마 즉시 적용
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = stored ?? (prefersDark ? 'dark' : 'dark'); // 기본 다크
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
      window.__theme = theme;
    </script>
  </head>
  <body class="relative overflow-x-hidden">
    <div id="spotlight"></div>
    <div class="grid-pattern fixed inset-0 -z-10 opacity-40"></div>

    <slot />

    <script is:inline>
      // ────────── 마우스 spotlight (다크 모드에서만 visible) ──────────
      (function () {
        const el = document.getElementById('spotlight');
        if (!el) return;
        let raf = 0;
        let x = window.innerWidth / 2,
          y = window.innerHeight / 2;
        let tx = x,
          ty = y;
        window.addEventListener('mousemove', (e) => {
          tx = e.clientX;
          ty = e.clientY;
          if (!raf) {
            raf = requestAnimationFrame(loop);
          }
        });
        function loop() {
          x += (tx - x) * 0.12;
          y += (ty - y) * 0.12;
          el.style.left = x + 'px';
          el.style.top = y + 'px';
          if (Math.abs(tx - x) > 0.5 || Math.abs(ty - y) > 0.5) {
            raf = requestAnimationFrame(loop);
          } else {
            raf = 0;
          }
        }
        loop();
      })();

      // ────────── 스크롤 시 페이드인 ──────────
      (function () {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in-view');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -10% 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      })();

      // ────────── 테마 토글 ──────────
      (function () {
        document.addEventListener('click', (e) => {
          const btn = e.target.closest && e.target.closest('[data-theme-toggle]');
          if (!btn) return;
          const root = document.documentElement;
          const next = root.classList.contains('dark') ? 'light' : 'dark';
          root.classList.toggle('dark', next === 'dark');
          localStorage.setItem('theme', next);
        });
      })();
    </script>
  </body>
</html>
