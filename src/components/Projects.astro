---
import projectData from '@/data/projects.json';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="section relative">
  <div class="container-x">
    <h2 class="section-title reveal">
      <span class="accent text-base font-mono">02.</span>
      Projects
    </h2>
    <p class="reveal mt-2 text-muted-light dark:text-muted-dark text-sm">
      실제 서비스에서 해결한 문제와 설계 판단을 중심으로 정리했습니다.
    </p>

    <div class="grid gap-8 mt-10" id="project-grid">
      {projectData.projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </div>
</section>
