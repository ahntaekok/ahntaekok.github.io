---
import profile from '@/data/profile.json';
---

<section id="contact" class="section relative">
  <div class="container-x text-center">
    <p class="accent font-mono text-sm reveal">04. What's Next?</p>
    <h2 class="reveal text-3xl sm:text-5xl font-bold mt-3">Get In Touch</h2>
    <p class="reveal mt-5 max-w-xl mx-auto text-muted-light dark:text-muted-dark leading-relaxed">
      함께 만들어볼 만한 프로젝트나, 채용 제안, 또는 그냥 안부 인사라도 좋습니다.
      <br />
      메일이 가장 빠르게 답장 드릴 수 있습니다.
    </p>

    <div class="reveal mt-10 flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={`mailto:${profile.email}`}
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-lg border border-accent-light dark:border-accent-dark text-accent-light dark:text-accent-dark hover:bg-accent-light/5 dark:hover:bg-accent-dark/5 transition-colors font-mono text-sm"
      >
        <span aria-hidden>✉</span>
        {profile.email}
      </a>
      <a
        href={`tel:${profile.phone}`}
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors font-mono text-sm"
      >
        <span aria-hidden>☏</span>
        {profile.phone}
      </a>
      <a
        href={profile.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors font-mono text-sm"
      >
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2 .37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
        GitHub
      </a>
    </div>
  </div>
</section>

<footer class="py-10 border-t border-slate-200/60 dark:border-slate-800/60">
  <div class="container-x text-center text-xs text-muted-light dark:text-muted-dark font-mono">
    <p>
      Designed & Built by <span class="accent">{profile.name}</span>
    </p>
    <p class="mt-2 opacity-70">Built with Astro + Tailwind CSS · Deployed on GitHub Pages</p>
  </div>
</footer>
